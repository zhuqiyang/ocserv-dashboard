[Unit]
Description=ocserv Web Manager
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/ocserv-manager/backend
ExecStart=/opt/ocserv-manager/backend/venv/bin/gunicorn -w 2 -b 0.0.0.0:5000 app:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
